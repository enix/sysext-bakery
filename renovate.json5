{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["release_build_versions.txt"],
      "description": "Teleport stopped publishing GitHub releases (and tags lag behind) after v18.10.0; the official APT repo is the up-to-date source, with one channel per major (stable/vNN). The 'v' prefix stays in the file, outside currentValue.",
      "matchStrings": [
        "(?m)^teleport v(?<currentValue>(?<major>\\d+)\\.\\d+\\.\\d+)$"
      ],
      "depNameTemplate": "gravitational/teleport",
      "packageNameTemplate": "teleport",
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://apt.releases.teleport.dev/ubuntu?suite=noble&components=stable/v{{{major}}}&binaryArch=amd64",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["gravitational/teleport"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "Never propose cross-major upgrades; each line in release_build_versions.txt is pinned to its major. To track a new major, add the line manually."
    },
    {
      "matchPackageNames": ["gravitational/teleport"],
      "commitMessageTopic": "teleport",
      "commitMessagePrefix": "chore(release):",
      "commitMessageAction": "bump"
    }
  ]
}
